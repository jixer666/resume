# 复制为 .env 后按实际环境修改（.env 已加入 .gitignore，不会进版本库）
#
# 说明：这个文件是给 docker compose 做变量替换用的，和 Spring 的 prod/dev profile 无关。
#   - 方案 A（手敲 docker run）：compose 不参与，这个文件用不上，密码直接写在命令里。
#   - 方案 B（docker compose）：下面的值就是 compose 里的默认值（和 application-prod.properties 一致），
#     只有「现有 mysql / redis 容器的密码不是下面这两个」或「11000 / 9001 被占用」时才需要复制成 .env 改。
#   - 复用已有 mysql / redis 时：密码必须和现有容器一致，否则后端连不上。

# ---------------- MySQL ----------------
MYSQL_ROOT_PASSWORD=jixer666mysql
MYSQL_DATABASE=resume

# ---------------- Redis ----------------
REDIS_PASSWORD=jixer666redis
# 对应 application-prod.properties 里的 resume.redis.index
REDIS_DB=3

# ---------------- 宿主机端口 ----------------
APP_PORT=11000
H5_PORT=9001
