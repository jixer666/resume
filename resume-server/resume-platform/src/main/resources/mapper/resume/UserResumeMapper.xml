<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.abc.resume.resume.mapper.UserResumeMapper">

    <resultMap type="com.abc.resume.resume.domain.entity.UserResume" id="UserResumeResult">
        <result property="id"    column="id"    />
        <result property="uid"    column="uid"    />
        <result property="title"    column="title"    />
        <result property="layout"    column="layout"    />
        <result property="resumeJson"    column="resume_json"    />
        <result property="thumbnail"    column="thumbnail"    />
        <result property="templateCode"    column="template_code"    />
        <result property="createTime"    column="create_time"    />
        <result property="status"    column="status"    />
        <result property="updateTime"    column="update_time"    />
        <result property="ver"    column="ver"    />
        <result property="isDelete"    column="is_delete"    />
    </resultMap>

    <sql id="selectUserResumeVo">
        select id, uid, title, layout, resume_json, thumbnail, template_code, create_time, status, update_time, ver, is_delete from user_resume
    </sql>

</mapper>
