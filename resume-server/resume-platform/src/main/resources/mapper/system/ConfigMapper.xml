<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.abc.resume.system.mapper.ConfigMapper">

    <resultMap type="com.abc.resume.core.config.model.Config" id="ConfigResult">
        <result property="configId"    column="config_id"    />
        <result property="code"    column="code"    />
        <result property="group"    column="group"    />
        <result property="value"    column="value"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="status"    column="status"    />
        <result property="ver"    column="ver"    />
        <result property="isDelete"    column="is_delete"    />
    </resultMap>

    <sql id="selectConfigVo">
        select config_id, code, `group`, value, create_time, update_time, status, ver, is_delete from config
    </sql>


    <select id="selectConfigByContext" resultMap="ConfigResult">
        <include refid="selectConfigVo"/>
        <where>
            <if test="code != null and code != ''">and code like concat('%', #{code}, '%')</if>
            <if test="updateTime != null">
                update_time >= #{updateTime}
            </if>
            <if test="delete != null">
                <if test="delete">
                    and is_delete = config_id
                </if>
                <if test="!delete">
                    and is_delete != config_id
                </if>
            </if>
        </where>
    </select>

</mapper>
