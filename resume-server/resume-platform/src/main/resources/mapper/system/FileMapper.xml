<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.abc.resume.system.mapper.FileMapper">

    <resultMap type="com.abc.resume.system.domain.entity.File" id="FileResult">
        <result property="id"    column="id"    />
        <result property="filename"    column="filename"    />
        <result property="totalSize"    column="total_size"    />
        <result property="fileType"    column="file_type"    />
        <result property="fileMd5"    column="file_md5"    />
        <result property="ossType"    column="oss_type"    />
        <result property="filePath"    column="file_path"    />
        <result property="userId"    column="user_id"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="status"    column="status"    />
        <result property="ver"    column="ver"    />
        <result property="isDelete"    column="is_delete"    />
    </resultMap>

    <sql id="selectFileVo">
        select id, filename, total_size, file_type, file_md5, oss_type, file_path, user_id, create_time, update_time, status, ver, is_delete from tb_file
    </sql>

    <select id="selectFileList" resultMap="FileResult">
        <include refid="selectFileVo" />
        where is_delete != id
    </select>

    <select id="selectById" resultMap="FileResult">
        <include refid="selectFileVo" />
        where id = #{id} and is_delete != id
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into tb_file (filename, total_size, file_type, file_md5, oss_type, file_path, user_id, create_time, update_time, status, ver, is_delete)
        values (#{filename}, #{totalSize}, #{fileType}, #{fileMd5}, #{ossType}, #{filePath}, #{userId}, #{createTime}, #{updateTime}, #{status}, #{ver}, #{isDelete})
    </insert>

    <update id="updateById">
        update tb_file
        <set>
            <if test="filename != null">filename = #{filename},</if>
            <if test="totalSize != null">total_size = #{totalSize},</if>
            <if test="fileType != null">file_type = #{fileType},</if>
            <if test="fileMd5 != null">file_md5 = #{fileMd5},</if>
            <if test="ossType != null">oss_type = #{ossType},</if>
            <if test="filePath != null">file_path = #{filePath},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="status != null">status = #{status},</if>
            update_time = now(),
            ver = ver + 1
        </set>
        where id = #{id} and is_delete != id
    </update>

    <update id="deleteBatchIds">
        update tb_file
        set is_delete = id,
            update_time = now(),
            ver = ver + 1
        where is_delete != id
        and id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

</mapper>
